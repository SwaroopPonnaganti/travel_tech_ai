# TBS RoamAgent — environment configuration
# Copy this file to `.env` (or export the variables) to enable optional features.
# Values here are only read by the Express API (server/), never shipped to the browser.

# Server
PORT=4000

# ── Conversational planner: server-side LLM (optional) ────────────────────────
# When ROAMAGENT_LLM_API_KEY is unset, /api/agent/plan returns 501 and the
# client automatically falls back to the deterministic on-device rule parser.
# The key is used only on the server and is never exposed to the client.
ROAMAGENT_LLM_API_KEY=
# Any OpenAI-compatible base URL (default: https://api.openai.com/v1)
ROAMAGENT_LLM_BASE_URL=https://api.openai.com/v1
# Model to call (default: gpt-4o-mini)
ROAMAGENT_LLM_MODEL=gpt-4o-mini
